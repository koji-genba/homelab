# Copy to the Apps VM as /etc/homelab/compose.env. Values may be image tags
# for a lab test, but production should use the corresponding @sha256 digest.
SECRETS_DIR=/etc/homelab/secrets
ADGUARD_CONFIG_DIR=/etc/homelab/adguard
ACME_EMAIL=operator@example.invalid
CADDY_TRUSTED_NETWORKS=192.168.10.0/24 192.168.11.0/24 192.168.20.0/24 100.64.0.0/10
GATUS_BASIC_AUTH_USER=operator
EDGE_BIND_IP=0.0.0.0
DNS_BIND_IP=0.0.0.0
SMB_BIND_IP=0.0.0.0

SHARED_MOUNT_PATH=/srv/homelab/nfs/shared
SHARED_HDD_MOUNT_PATH=/srv/homelab/nfs/shared-hdd
ARCHIVE_MOUNT_PATH=/srv/homelab/nfs/archive
STASHPAD_MEDIA_MOUNT_PATH=/srv/homelab/nfs/stashpad-media
STASHPAD_DATA_PATH=/srv/homelab/nfs/stashpad-prod
STASHPAD_STAGING_DATA_PATH=/srv/homelab/nfs/stashpad-staging
SILLYTAVERN_DATA_PATH=/srv/homelab/nfs/sillytavern
