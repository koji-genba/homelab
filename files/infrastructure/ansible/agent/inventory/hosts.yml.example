all:
  children:
    agent:
      hosts:
        agent-vm:
          # Agent VM management address. Confirm it before copying this file to
          # hosts.yml; Ansible never assigns or probes this address.
          ansible_host: 192.168.10.104
          ansible_user: deploy
          ansible_become: true
          ansible_ssh_private_key_file: "~/.ssh/homelab_ed25519"
    runner:
      hosts:
        runner-vm:
          # Runner VM management address. Confirm it before copying this file.
          ansible_host: 192.168.10.105
          ansible_user: deploy
          ansible_become: true
          ansible_ssh_private_key_file: "~/.ssh/homelab_ed25519"
