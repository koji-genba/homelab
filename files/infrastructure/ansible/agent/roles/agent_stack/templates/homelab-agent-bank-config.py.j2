#!/usr/bin/env python3
"""Apply the Hindsight bank policy.

Rendered by the homelab Ansible role agent_stack and piped into the running
Hindsight container as `python3 -` (the API has no published host port). It
creates the bank on first run and only writes when something drifts, so a repeat
apply is a no-op. Prints "changed <fields>" or "unchanged".
"""

import json
import sys
import urllib.error
import urllib.parse
import urllib.request

BASE = "http://127.0.0.1:8888"
BANK = sys.argv[1] if len(sys.argv) > 1 else {{ agent_stack_bank_id | to_json }}
DESIRED = {
    "reflect_mission": {{ agent_stack_bank_reflect_mission | to_json }},
    "retain_mission": {{ agent_stack_bank_retain_mission | to_json }},
    "retain_extraction_mode": {{ agent_stack_bank_retain_extraction_mode | to_json }},
    "retain_custom_instructions": {{ agent_stack_bank_retain_custom_instructions | to_json }},
    "observations_mission": {{ agent_stack_bank_observations_mission | to_json }},
    "disposition_skepticism": {{ agent_stack_bank_disposition_skepticism | int }},
    "disposition_literalism": {{ agent_stack_bank_disposition_literalism | int }},
    "disposition_empathy": {{ agent_stack_bank_disposition_empathy | int }},
}


def request(method, url, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    if data is not None:
        req.add_header("Content-Type", "application/json")
    with urllib.request.urlopen(req, timeout=60) as resp:
        raw = resp.read()
    return json.loads(raw) if raw else {}


def fail(message):
    print("bank-config: " + message, file=sys.stderr)
    sys.exit(1)


url = "{}/v1/default/banks/{}/config".format(BASE, urllib.parse.quote(BANK, safe=""))
bank_url = "{}/v1/default/banks/{}".format(BASE, urllib.parse.quote(BANK, safe=""))

try:
    current = request("GET", url).get("config", {})
    drift = {k: v for k, v in DESIRED.items() if current.get(k) != v}
    if not drift:
        print("bank-config: unchanged")
        sys.exit(0)
    request("PUT", bank_url, DESIRED)
except urllib.error.HTTPError as exc:
    if exc.code != 404:
        fail("GET failed: HTTP {}".format(exc.code))
    try:
        request("PUT", bank_url, DESIRED)
        drift = DESIRED
    except urllib.error.HTTPError as put_exc:
        fail("bank create failed: HTTP {}: {}".format(put_exc.code, put_exc.read()[:400]))
except Exception as exc:  # noqa: BLE001 - surface any transport error to Ansible
    fail("unexpected error: {}".format(exc))

print("bank-config: changed " + ",".join(sorted(drift)))
