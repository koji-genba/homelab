# Managed by the homelab Ansible role agent_stack. Non-secret values the Agent
# Compose project interpolates. The compose wrapper also passes
# {{ agent_stack_secrets_dir }}/memory-db.env so POSTGRES_PASSWORD is available
# for interpolation into Hindsight's DATABASE_URL; nothing secret belongs here.
SECRETS_DIR={{ agent_stack_secrets_dir }}
AGENT_SSH_KEY_DIR={{ agent_stack_ssh_key_dir }}
HERMES_DATA_DIR={{ agent_stack_hermes_data_dir }}
POSTGRES_DATA_DIR={{ agent_stack_postgres_data_dir }}
MODELS_DIR={{ agent_stack_models_dir }}
APPS_VM_LAN_IP={{ agent_stack_apps_lan_ip }}
SEARXNG_FQDN={{ agent_stack_searxng_fqdn }}
MCP_SEARXNG_FQDN={{ agent_stack_mcp_searxng_fqdn }}
# Local snapshot paths also prevent Rust hf-hub from probing absent ONNX files;
# HF_HUB_OFFLINE alone does not prevent those HTTP probes in TEI cpu-1.8.3.
TEI_EMBEDDING_MODEL=/data/models--{{ agent_stack_embedding_model | replace('/', '--') }}/snapshots/{{ agent_stack_embedding_revision }}
TEI_EMBEDDING_REVISION={{ agent_stack_embedding_revision }}
TEI_RERANKER_MODEL=/data/models--{{ agent_stack_reranker_model | replace('/', '--') }}/snapshots/{{ agent_stack_reranker_revision }}
TEI_RERANKER_REVISION={{ agent_stack_reranker_revision }}
TEI_RERANKER_CPUS={{ agent_stack_reranker_cpus }}
TEI_RERANKER_THREADS={{ agent_stack_reranker_threads }}
TEI_RERANKER_TOKENIZATION_WORKERS={{ agent_stack_reranker_tokenization_workers }}
TEI_RERANKER_MAX_BATCH_REQUESTS={{ agent_stack_reranker_max_batch_requests }}
# ruri-v3 is asymmetric: the query and passage prefixes carry the task and end
# with a space the model card keeps. Quote them so the env-file parser preserves
# the trailing space (an unquoted value would be trimmed) and the space reaches
# Hindsight intact.
HINDSIGHT_EMBEDDINGS_QUERY_PREFIX="{{ agent_stack_embedding_query_prefix }}"
HINDSIGHT_EMBEDDINGS_PASSAGE_PREFIX="{{ agent_stack_embedding_passage_prefix }}"
HINDSIGHT_EMBEDDINGS_MAX_INPUT_TOKENS={{ agent_stack_embeddings_max_input_tokens }}
HINDSIGHT_RERANKER_MAX_CANDIDATES_LOW={{ agent_stack_reranker_max_candidates_low }}
HINDSIGHT_RERANKER_MAX_CANDIDATES_MID={{ agent_stack_reranker_max_candidates_mid }}
HINDSIGHT_RERANKER_MAX_CANDIDATES_HIGH={{ agent_stack_reranker_max_candidates_high }}
HINDSIGHT_LLM_BASE_URL={{ agent_stack_llm_base_url }}
HINDSIGHT_LLM_MODEL={{ agent_stack_llm_model }}
HINDSIGHT_LLM_MAX_CONCURRENT={{ agent_stack_llm_max_concurrent }}
HINDSIGHT_LLM_REASONING_EFFORT={{ agent_stack_hindsight_reasoning_effort }}
HINDSIGHT_LLM_STRICT_SCHEMA={{ agent_stack_hindsight_strict_schema | bool | ternary('true', 'false') }}
AGENT_TIMEZONE={{ agent_stack_timezone }}
CDP_TUNNEL_PORT={{ agent_stack_cdp_port }}
CDP_RUNNER_TARGET={{ agent_stack_cdp_runner_target }}
