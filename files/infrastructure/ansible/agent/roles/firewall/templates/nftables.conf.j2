{% set ssh_networks = firewall_ssh_allowed_networks | join(', ') %}
{% set rejected_networks = firewall_egress_rejected_networks | join(', ') %}
{% set trusted_networks = firewall_trusted_networks | join(', ') %}
table inet homelab_filter {
  chain input {
    type filter hook input priority 0; policy drop;

    iifname "lo" accept
{% if firewall_webapp_port | int > 0 %}
    # Also cover host/userland-proxy delivery before established-state accepts.
    ip saddr {{ firewall_webapp_allowed_source }} tcp dport {{ firewall_webapp_port }} accept
    tcp dport {{ firewall_webapp_port }} drop
{% endif %}
    ct state established,related accept
    ct state invalid drop

    # Keep ICMP reachable for diagnostics and path-MTU discovery.
    ip protocol icmp accept

    ip saddr { {{ ssh_networks }} } tcp dport 22 accept
{% if firewall_input_allowed_tcp_ports | length > 0 %}
    ip saddr { {{ ssh_networks }} } tcp dport { {{ firewall_input_allowed_tcp_ports | join(', ') }} } accept
{% endif %}
  }

{% if firewall_dnat_guard | bool %}
  chain forward {
    # Defence in depth equivalent to the Apps VM guard: drop forwarded packets
    # that Docker DNAT'd (a published `ports:` entry) when the source is outside
    # firewall_trusted_networks. Docker owns its own filter/nat chains; this is
    # an independent early guard and never flushes or replaces Docker's rules.
    type filter hook forward priority -100; policy accept;
{% if firewall_webapp_port | int > 0 %}
    # Match the published ORIGINAL port, before broad trusted/established rules.
    # This also matches reply packets: use the ORIGINAL source, not the container IP.
    # DNAT happens at prerouting -100, before this forward hook.
    ct status dnat meta l4proto tcp ct original proto-dst {{ firewall_webapp_port }} ct original ip saddr != {{ firewall_webapp_allowed_source }} drop
{% endif %}
    ct state established,related accept
    ct status dnat ip saddr != { {{ trusted_networks }} } drop
  }

{% endif %}
  chain output {
    type filter hook output priority 0; policy accept;
{% if firewall_egress_restrict | bool %}
    iifname "lo" accept
    ct state established,related accept
{% for resolver in firewall_egress_allowed_dns %}
    ip daddr {{ resolver }} udp dport 53 accept
    ip daddr {{ resolver }} tcp dport 53 accept
{% endfor %}
{% for network in firewall_egress_allowed_networks %}
    ip daddr {{ network }} accept
{% endfor %}
    # PRD 4.2: block NEW connections to the LAN, RFC1918, CGNAT/tailnet
    # (100.64.0.0/10) and link-local ranges. The internet stays reachable
    # through the default-accept policy above these rules. Exceptions are
    # variable-driven (firewall_egress_allowed_dns /
    # firewall_egress_allowed_networks).
    ip daddr { {{ rejected_networks }} } ct state new reject
{% endif %}
  }
}
