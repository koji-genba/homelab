#!/usr/bin/python3 -I
"""GitHub App broker. Fixed paths/environment; no caller-controlled configuration."""
import base64
import datetime
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import time
import urllib.request

CONFIG = Path('/etc/homelab/secrets/github-app.json')
KEY = Path('/etc/homelab/secrets/github-app.pem')
CACHE = Path('/var/lib/gh-broker')
API = 'https://api.github.com'
SAFE_ENV = {'PATH': '/usr/bin:/bin', 'LANG': 'C.UTF-8'}


def repository(value):
    if not re.fullmatch(r'[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9_.-]{1,100}', value):
        raise ValueError('invalid repository')
    owner, repo = value.split('/')
    if '--' in owner or repo in ('.', '..') or repo.endswith('.git'):
        raise ValueError('invalid repository')
    return owner, repo


def b64(value):
    return base64.urlsafe_b64encode(value).rstrip(b'=')


def jwt(app_id):
    now = int(time.time())
    unsigned = b'.'.join(b64(json.dumps(value, separators=(',', ':')).encode()) for value in (
        {'alg': 'RS256', 'typ': 'JWT'}, {'iat': now - 60, 'exp': now + 540, 'iss': str(app_id)}))
    signature = subprocess.run(['/usr/bin/openssl', 'dgst', '-sha256', '-sign', str(KEY)],
                               input=unsigned, capture_output=True, check=True, timeout=10,
                               env=SAFE_ENV).stdout
    return (unsigned + b'.' + b64(signature)).decode()


def request(path, authorization, data=None):
    req = urllib.request.Request(API + path, data=None if data is None else json.dumps(data).encode(),
                                 headers={'Authorization': 'Bearer ' + authorization,
                                          'Accept': 'application/vnd.github+json',
                                          'X-GitHub-Api-Version': '2022-11-28',
                                          'User-Agent': 'homelab-gh-broker', 'Content-Type': 'application/json'})
    # Ignore caller-controlled proxy environment and never forward a JWT on redirects.
    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *args, **kwargs):
            return None
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
    with opener.open(req, timeout=20) as response:
        return json.load(response)


def expiry(value):
    return datetime.datetime.fromisoformat(value.replace('Z', '+00:00')).timestamp()


def token(target):
    owner, repo = repository(target)
    settings = json.loads(CONFIG.read_text())
    for key in ('app_id', 'installation_id'):
        if not re.fullmatch(r'[1-9][0-9]*', str(settings[key])):
            raise ValueError('invalid configuration')
    # Include configuration and key identity so rotation cannot reuse an old token.
    identity = CONFIG.read_bytes() + KEY.read_bytes() + target.lower().encode()
    name = hashlib.sha256(identity).hexdigest()
    os.umask(0o077)
    with (CACHE / (name + '.lock')).open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        cached = CACHE / (name + '.json')
        try:
            item = json.loads(cached.read_text())
            if expiry(item['expires_at']) - time.time() >= 300:
                return item['token']
        except (OSError, ValueError, KeyError, TypeError):
            pass
        authorization = jwt(settings['app_id'])
        installation = request('/app/installations/' + str(settings['installation_id']), authorization)
        if installation['account']['login'].lower() != owner.lower():
            raise ValueError('installation owner mismatch')
        item = request('/app/installations/' + str(settings['installation_id']) + '/access_tokens', authorization,
                       {'repositories': [repo], 'permissions': {
                           'contents': 'write', 'pull_requests': 'write', 'metadata': 'read'}})
        if expiry(item['expires_at']) - time.time() < 300 or not re.fullmatch(r'[A-Za-z0-9_]+', item['token']):
            raise ValueError('invalid token response')
        fd, name = tempfile.mkstemp(dir=CACHE, prefix='.token-')
        try:
            with os.fdopen(fd, 'w') as stream:
                json.dump({'token': item['token'], 'expires_at': item['expires_at']}, stream)
            os.replace(name, cached)
        finally:
            if os.path.exists(name):
                os.unlink(name)
        return item['token']


def main():
    try:
        if len(sys.argv) != 2:
            raise ValueError('one repository required')
        print(token(sys.argv[1]))
    except Exception:
        # Never include API bodies, subprocess output, JWTs or configuration values.
        print('GitHub App token unavailable', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
