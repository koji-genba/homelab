#!/usr/bin/python3 -I
"""Git credential protocol for github.com HTTPS, using the isolated broker."""
import re
import subprocess
import sys

BROKER = ['/usr/bin/sudo', '-n', '-u', 'gh-broker', '/usr/local/libexec/agent-job-github-token']


def credential(operation, source):
    if operation in ('store', 'erase'):
        return ''
    if operation != 'get':
        raise ValueError('unsupported operation')
    fields = {}
    for line in source.splitlines():
        if not line:
            break
        key, value = line.split('=', 1)
        if key in fields:
            raise ValueError('duplicate field')
        fields[key] = value
    if fields.get('protocol') != 'https' or fields.get('host') != 'github.com':
        return ''
    target = fields.get('path', '')
    if target.endswith('.git'):
        target = target[:-4]
    if not re.fullmatch(r'[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9_.-]{1,100}', target):
        raise ValueError('invalid repository')
    owner, repo = target.split('/')
    if '--' in owner or repo in ('.', '..') or repo.endswith('.git'):
        raise ValueError('invalid repository')
    result = subprocess.run(BROKER + [target], capture_output=True, text=True, timeout=55,
                            env={'PATH': '/usr/bin:/bin', 'LANG': 'C.UTF-8'}, check=True)
    token = result.stdout.strip()
    if not re.fullmatch(r'[A-Za-z0-9_]+', token):
        raise ValueError('invalid broker output')
    return 'username=x-access-token\npassword=' + token + '\n\n'


def main():
    try:
        if len(sys.argv) != 2:
            raise ValueError('operation required')
        # store/erase must not consume or persist supplied credentials.
        source = sys.stdin.read(16385) if sys.argv[1] == 'get' else ''
        if len(source) > 16384:
            raise ValueError('input too long')
        sys.stdout.write(credential(sys.argv[1], source))
        return 0
    except Exception:
        print('GitHub credential unavailable', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
