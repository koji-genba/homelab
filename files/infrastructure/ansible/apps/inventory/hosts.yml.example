all:
  children:
    apps:
      hosts:
        apps-vm:
          # Apps VM management address. Confirm it before copying this file
          # to hosts.yml; Ansible never assigns or probes this address.
          ansible_host: 192.168.10.101
          ansible_user: deploy
          ansible_become: true
          ansible_ssh_private_key_file: "~/.ssh/homelab_ed25519"
