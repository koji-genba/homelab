#!/bin/sh
set -eu

fail() {
  echo "homelab mount guard: $*" >&2
  exit 1
}

{% for mount in nfs_mounts %}
mount_path={{ mount.local_path | quote }}
marker="$mount_path/{{ mount.marker }}"
expected_source={{ (mount.server ~ ':' ~ mount.export) | quote }}
expected_mode={{ ('ro' if (not (application_cutover_confirmed | default(false) | bool) or 'ro' in mount.options.split(',')) else 'rw') | quote }}
actual_source=$(findmnt -rn -M "$mount_path" -o SOURCE 2>/dev/null || true)
actual_fstype=$(findmnt -rn -M "$mount_path" -o FSTYPE 2>/dev/null || true)
actual_options=$(findmnt -rn -M "$mount_path" -o OPTIONS 2>/dev/null || true)
test "$actual_source" = "$expected_source" || fail "$mount_path source is $actual_source, expected $expected_source"
test "$actual_fstype" = nfs4 || fail "$mount_path is not an nfs4 mount (fstype: $actual_fstype)"
printf '%s\n' "$actual_options" | tr ',' '\n' | grep -qx "$expected_mode" \
  || fail "$mount_path mode is not $expected_mode (options: $actual_options)"
test -e "$marker" || fail "missing export marker $marker"
expected_marker={{ mount.marker_value | default(mount.name) | quote }}
actual_marker=$(cat "$marker" 2>/dev/null || true)
test "$actual_marker" = "$expected_marker" || fail "marker mismatch at $marker"
{% endfor %}

exit 0
