SECRETS_DIR=/etc/homelab/secrets
ADGUARD_CONFIG_DIR=/etc/homelab/adguard
APPLICATION_CUTOVER_CONFIRMED={{ 'true' if (application_cutover_confirmed | default(false) | bool) else 'false' }}
ACME_EMAIL={{ acme_email }}
GATUS_BASIC_AUTH_USER={{ gatus_basic_auth_user | default('operator') }}
CADDY_TRUSTED_NETWORKS={{ '192.168.10.0/24 192.168.20.0/24 100.64.0.0/10' if (network_migration_complete | default(false) | bool) else '192.168.10.0/24 192.168.11.0/24 192.168.20.0/24 100.64.0.0/10' }}
EDGE_BIND_IP={{ '192.168.10.101' if (network_migration_complete | default(false) | bool) else (legacy_edge_ip | default('192.168.11.100') if (legacy_service_addresses_enabled | default(false) | bool) else '0.0.0.0') }}
DNS_BIND_IP={{ '192.168.10.101' if (network_migration_complete | default(false) | bool) else (legacy_dns_ip | default('192.168.11.101') if (legacy_service_addresses_enabled | default(false) | bool) else '0.0.0.0') }}
SMB_BIND_IP={{ '192.168.10.101' if (network_migration_complete | default(false) | bool) else (legacy_smb_ip | default('192.168.11.103') if (legacy_service_addresses_enabled | default(false) | bool) else '0.0.0.0') }}
SHARED_MOUNT_PATH={{ shared_mount_path }}
SHARED_HDD_MOUNT_PATH={{ shared_hdd_mount_path }}
ARCHIVE_MOUNT_PATH={{ archive_mount_path }}
STASHPAD_MEDIA_MOUNT_PATH={{ stashpad_media_mount_path }}
STASHPAD_DATA_PATH={{ stashpad_data_path }}
STASHPAD_STAGING_DATA_PATH={{ stashpad_staging_data_path }}
SILLYTAVERN_DATA_PATH={{ sillytavern_data_path }}
