[Unit]
Description=Start homelab Docker Compose projects after NFS validation
{% set legacy_addr_dep = ' homelab-service-addresses.service' if (legacy_service_addresses_enabled | default(false) | bool) else '' %}
Requires=docker.service homelab-mount-guard.service{{ legacy_addr_dep }}
PartOf=docker.service
After=docker.service homelab-mount-guard.service network-online.target{{ legacy_addr_dep }}
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/homelab-compose-up all
ExecStop=/usr/local/sbin/homelab-compose-down all
TimeoutStopSec={{ compose_wait_timeout_seconds | default(120) | int }}
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
