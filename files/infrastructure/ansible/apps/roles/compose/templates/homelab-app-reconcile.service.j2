[Unit]
Description=Fast-forward and reconcile one homelab application project
{% set legacy_addr_dep = ' homelab-service-addresses.service' if (legacy_service_addresses_enabled | default(false) | bool) else '' %}
Requires=docker.service homelab-mount-guard.service{{ legacy_addr_dep }}
After=docker.service homelab-mount-guard.service network-online.target{{ legacy_addr_dep }}

[Service]
Type=oneshot
# The helper detects all affected application projects from the fetched diff;
# it never applies infrastructure, secrets, or firewall changes.
ExecStart=/usr/local/sbin/homelab-app-reconcile
