schema_version: 34
{% set web_ip = '192.168.10.101' if (network_migration_complete | default(false) | bool) else '192.168.11.100' %}
{% set smb_ip = '192.168.10.101' if (network_migration_complete | default(false) | bool) else '192.168.11.103' %}
{% set ldaps_ip = '192.168.10.101' if (network_migration_complete | default(false) | bool) else (legacy_ldaps_ip | default('192.168.11.102')) %}
http:
  address: 0.0.0.0:3000
  session_ttl: 24h
  doh:
    insecure_enabled: false
    routes:
      - GET /dns-query
      - POST /dns-query
      - GET /dns-query/{ClientID}
      - POST /dns-query/{ClientID}
users:
  - name: {{ secrets_runtime.adguard.username | quote }}
    password: {{ secrets_runtime.adguard.password_hash | quote }}
dns:
  bind_hosts:
    - 0.0.0.0
  port: 53
  upstream_dns:
    - https://cloudflare-dns.com/dns-query
  fallback_dns:
    - https://dns.quad9.net/dns-query
  bootstrap_dns:
    - 1.1.1.1
    - 9.9.9.9
  upstream_mode: parallel
  use_http3_upstream: false
  enable_dnssec: true
  cache_enabled: true
  cache_size: 4194304
  cache_ttl_min: 0
  cache_ttl_max: 0
  cache_optimistic: false
  cache_optimistic_answer_ttl: 30s
  cache_optimistic_max_age: 12h
filtering:
  protection_enabled: true
  filtering_enabled: true
  blocking_mode: nxdomain
  rewrites_enabled: true
  parental_enabled: false
  safebrowsing_enabled: false
  safe_search:
    enabled: false
    bing: false
    duckduckgo: false
    ecosia: false
    google: false
    pixabay: false
    yandex: false
    youtube: false
  rewrites:
    - domain: dnsTestRecord.kojigenba-srv.com
      answer: 192.168.63.254
      enabled: true
    - domain: staging.kojigenba-srv.com
      answer: {{ web_ip }}
      enabled: true
    - domain: prod.kojigenba-srv.com
      answer: {{ web_ip }}
      enabled: true
    - domain: ldap.kojigenba-srv.com
      answer: {{ web_ip }}
      enabled: true
    - domain: phpadmin.kojigenba-srv.com
      answer: {{ web_ip }}
      enabled: true
    - domain: ldaps.kojigenba-srv.com
      answer: {{ ldaps_ip }}
      enabled: true
    - domain: samba.kojigenba-srv.com
      answer: {{ smb_ip }}
      enabled: true
    - domain: staging.stashpad.kojigenba-srv.com
      answer: {{ web_ip }}
      enabled: true
    - domain: prod.stashpad.kojigenba-srv.com
      answer: {{ web_ip }}
      enabled: true
    - domain: sillytavern.kojigenba-srv.com
      answer: {{ web_ip }}
      enabled: true
    - domain: dns.kojigenba-srv.com
      answer: {{ web_ip }}
      enabled: true
    - domain: status.kojigenba-srv.com
      answer: {{ web_ip }}
      enabled: true
  filters_update_interval: 24
tls:
  enabled: false
filters:
  - enabled: true
    url: https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@main/adblock/pro.txt
    name: HaGeZi Pro（広告・トラッカー対策）
    id: 1
  - enabled: true
    url: https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@main/adblock/tif.txt
    name: HaGeZi TIF（脅威インテリジェンス）
    id: 2
  - enabled: true
    url: https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@main/adblock/doh-vpn-proxy-bypass.txt
    name: HaGeZi DoH/VPN/Proxy（迂回対策）
    id: 3
  - enabled: true
    url: https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@main/adblock/dyndns.txt
    name: HaGeZi Dynamic DNS（悪用対策）
    id: 4
  - enabled: true
    url: https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@main/adblock/hoster.txt
    name: HaGeZi Hoster（不正ホスティング対策）
    id: 5
  - enabled: true
    url: https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@main/adblock/urlshortener.txt
    name: HaGeZi URL Shortener（短縮URL対策）
    id: 6
whitelist_filters: []
# Read the checked-in Git rules once on the Ansible controller. This keeps the
# files under compose/dns/filters as the single source of truth while the
# runtime AGH data directory remains outside the checkout.
user_rules:
{% set allowlist = lookup('file', playbook_dir + '/../../../services/compose/dns/filters/allowlist.txt') %}
{% set blocklist = lookup('file', playbook_dir + '/../../../services/compose/dns/filters/blocklist.txt') %}
{% for rule in allowlist.splitlines() %}{% if rule.strip() and not rule.lstrip().startswith('#') %}
  - {{ rule.strip() | quote }}{% endif %}{% endfor %}
{% for rule in blocklist.splitlines() %}{% if rule.strip() and not rule.lstrip().startswith('#') %}
  - {{ rule.strip() | quote }}{% endif %}{% endfor %}
querylog:
  enabled: true
  file_enabled: true
  interval: 168h
  anonymize_client_ip: false
  ignored: []
  ignored_enabled: false
statistics:
  enabled: true
  interval: 168h
  ignored: []
  ignored_enabled: false
