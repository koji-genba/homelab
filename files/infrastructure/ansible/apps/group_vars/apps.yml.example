---
# Copy to group_vars/apps.yml and adjust paths after inspecting the restored
# NFS export. This file contains no credentials.
apps_management_ip: 192.168.10.42
apps_final_management_ip: 192.168.10.101
network_migration_complete: false
legacy_service_addresses_enabled: false
legacy_service_cutover_confirmed: false
legacy_service_interface_name: ens19
legacy_service_addresses:
  - 192.168.11.100/24  # Caddy/HTTP (cutover only)
  - 192.168.11.101/24  # AdGuard Home (cutover only)
  - 192.168.11.103/24  # Samba (cutover only)

legacy_edge_ip: 192.168.11.100
legacy_dns_ip: 192.168.11.101
legacy_smb_ip: 192.168.11.103
legacy_ldaps_ip: 192.168.11.102

deploy_user: deploy
deploy_public_key: "ssh-ed25519 AAAA... operator@example"
runtime_secrets_file: "{{ playbook_dir }}/../../secrets/runtime.sops.yaml"

compose_install_dir: /opt/homelab
compose_project_dir: /opt/homelab/compose
compose_env_file: /etc/homelab/compose.env
homelab_repo_url: https://github.com/koji-genba/homelab.git
homelab_repo_branch: main
acme_email: operator@example.invalid

# These are the restored NFS exports and the exact opaque Kubernetes PV
# directories found in the existing manifests. Export-side configuration is
# never changed by Ansible. Each marker must already exist on the export.
nfs_mounts:
  - name: shared
    local_path: /srv/homelab/nfs/shared
    server: 192.168.10.11
    export: /mnt/shared
    marker: .homelab-export
    marker_value: shared
    options: hard,_netdev,nfsvers=4.1,noatime,rsize=1048576,wsize=1048576,timeo=600,retrans=2,nconnect=8
  - name: shared-hdd
    local_path: /srv/homelab/nfs/shared-hdd
    server: 192.168.10.11
    export: /mnt/tank-gen2/data/shared
    marker: .homelab-export
    marker_value: shared-hdd
    options: hard,_netdev,nfsvers=4.1,noatime,rsize=1048576,wsize=1048576,timeo=600,retrans=2,nconnect=8
  - name: archive
    local_path: /srv/homelab/nfs/archive
    server: 192.168.10.11
    export: /mnt/tank-gen1/data/archive
    marker: .homelab-export
    marker_value: archive
    options: hard,_netdev,nfsvers=4.1,noatime,rsize=1048576,wsize=1048576,timeo=600,retrans=2,nconnect=8
  - name: stashpad-media
    local_path: /srv/homelab/nfs/stashpad-media
    server: 192.168.10.11
    export: /mnt/shared/koji-genba/stashPadLib
    marker: .homelab-export
    marker_value: stashpad-media
    options: hard,_netdev,nfsvers=4.1,noatime,ro
  - name: sillytavern-data
    local_path: /srv/homelab/nfs/sillytavern
    server: 192.168.10.11
    export: /mnt/tank-gen2/data/k8s-volumes/sillytavern-sillytavern-data-pvc-85f01a24-9480-4341-a6ad-f44b17cbecaa
    marker: .homelab-export
    marker_value: sillytavern-data
    options: hard,_netdev,nfsvers=4.1,noatime
  - name: stashpad-prod-data
    local_path: /srv/homelab/nfs/stashpad-prod
    server: 192.168.10.11
    export: /mnt/tank-gen2/data/k8s-volumes/stashpad-prod-stashpad-data-pvc-c96b1813-be70-49ca-865f-989e77359a6b
    marker: .homelab-export
    marker_value: stashpad-prod-data
    options: hard,_netdev,nfsvers=4.1,noatime
  - name: stashpad-staging-data
    local_path: /srv/homelab/nfs/stashpad-staging
    server: 192.168.10.11
    export: /mnt/tank-gen2/data/k8s-volumes/stashpad-staging-stashpad-data-pvc-ecc8b17c-bd0a-47db-b169-248d5d98995b
    marker: .homelab-export
    marker_value: stashpad-staging-data
    options: hard,_netdev,nfsvers=4.1,noatime

shared_mount_path: /srv/homelab/nfs/shared
shared_hdd_mount_path: /srv/homelab/nfs/shared-hdd
archive_mount_path: /srv/homelab/nfs/archive
stashpad_media_mount_path: /srv/homelab/nfs/stashpad-media

# Existing PVC directory names are intentionally required inputs. Do not
# guess these names: verify them on the restored export before deployment.
stashpad_data_path: /srv/homelab/nfs/stashpad-prod
stashpad_staging_data_path: /srv/homelab/nfs/stashpad-staging
sillytavern_data_path: /srv/homelab/nfs/sillytavern

trusted_networks:
  - 192.168.10.0/24
  - 192.168.11.0/24
  - 192.168.20.0/24
  - 100.64.0.0/10

healthchecks_ping_period: 60
healthchecks_rootfs_max_percent: 90
compose_wait_timeout_seconds: 120
application_cutover_confirmed: false
