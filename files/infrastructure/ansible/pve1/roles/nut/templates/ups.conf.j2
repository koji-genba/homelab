# Managed by Ansible; CPJ1200 USB on pve1.
[cpj1200]
    driver = usbhid-ups
    port = auto
    vendorid = 0764
    productid = 0501
    desc = "CyberPower CPJ1200"
    offdelay = {{ nut_offdelay }}
    ondelay = {{ nut_ondelay }}
{% if nut_ignorelb | bool %}
    ignorelb
{% endif %}
{% if nut_battery_charge_low is not none %}
    override.battery.charge.low = {{ nut_battery_charge_low }}
{% endif %}
{% if nut_battery_runtime_low is not none %}
    override.battery.runtime.low = {{ nut_battery_runtime_low }}
{% endif %}
