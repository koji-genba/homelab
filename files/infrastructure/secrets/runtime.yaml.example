# Inventory only. Fill the values in a local copy, encrypt it with SOPS/age,
# and commit only the resulting `runtime.sops.yaml`. Never commit plaintext
# values or this example after adding values.
cloudflare:
  api_token: REPLACE_WITH_CLOUDFLARE_DNS_API_TOKEN
adguard:
  username: REPLACE_WITH_ADGUARD_ADMIN_USERNAME
  # bcrypt hash generated by AdGuard Home, never the plaintext password.
  password_hash: REPLACE_WITH_ADGUARD_PASSWORD_HASH
gatus:
  discord_webhook_url: REPLACE_WITH_DISCORD_WEBHOOK_URL
  # bcrypt/argon2 hash accepted by Caddy basic_auth, not a plaintext password.
  basic_auth_hash: REPLACE_WITH_CADDY_PASSWORD_HASH
samba:
  koji-genba-password: REPLACE_WITH_SAMBA_PASSWORD
sillytavern:
  username: REPLACE_WITH_SILLYTAVERN_USERNAME
  password: REPLACE_WITH_SILLYTAVERN_PASSWORD
healthchecks:
  ping_url: REPLACE_WITH_HEALTHCHECKS_DEAD_MAN_URL
