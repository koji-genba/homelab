# Inventory only, for the Agent VM bundle. Fill the values in a local copy,
# encrypt it with SOPS/age and commit only the resulting `runtime.sops.yaml`.
# Never commit plaintext values or this example after adding values.
#
# Encrypt/decrypt targets: `make secrets-encrypt-agent` /
# `make secrets-decrypt-check-agent` (bundle path
# files/infrastructure/secrets/agent/runtime.sops.yaml, plaintext
# files/infrastructure/secrets/agent/runtime.yaml, both gitignored plaintext and
# forbidden by scripts/validate-secrets.sh).
discord:
  # Bot token for the own-use Hermes application.
  bot_token: REPLACE_WITH_DISCORD_BOT_TOKEN
  # Comma-separated Discord numeric user IDs allowed to talk to the agent.
  allowed_users: REPLACE_WITH_DISCORD_ALLOWED_USER_ID
  # Comma-separated channel IDs the agent may answer in (config.yaml routing).
  allowed_channels: REPLACE_WITH_DISCORD_ALLOWED_CHANNEL_ID
  # Comma-separated channel IDs where the agent answers without being mentioned.
  free_response_channels: REPLACE_WITH_DISCORD_FREE_RESPONSE_CHANNEL_ID
  # Discord channel ID that receives cron deliveries (e.g. weekly-review).
  home_channel: REPLACE_WITH_DISCORD_HOME_CHANNEL_ID
monitoring:
  # inbound webhook used by the WS5 health timer for alerts.
  operator_webhook_url: REPLACE_WITH_OPERATOR_WEBHOOK_URL
  # Optional dead-man's-switch ping URL; empty string disables the ping.
  deadman_ping_url: ""
